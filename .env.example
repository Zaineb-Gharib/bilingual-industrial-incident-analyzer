# Safe default: deterministic offline demo mode.
LLM_PROVIDER=demo
LLM_MODEL=demo-v1
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=1800
APP_STORE_RAW_INPUTS=false
APP_DATABASE_PATH=data/local/app.db
LOG_LEVEL=INFO

# Example live configuration. Choose a current model available to your account.
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=gpt-5.4-mini
# LLM_API_KEY=your_api_key_here
